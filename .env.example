# Configuración de entorno para el pipeline de doblaje
# Copia este archivo como .env y configúralo

# Puerto de la interfaz web
WEB_PORT=8080

# URL de la API de Ollama (por defecto es localhost:11434 en local)
OLLAMA_HOST=http://localhost:11434

# Habilitar modo depuración (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Clave opcional de Hugging Face si necesitas descargar modelos privados
# HF_TOKEN=your_huggingface_token_here
